# Copy to .env.local for `vercel dev` (never commit real values).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required. Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Defaults to gemini-3.8-flash if empty.
# Run `pnpm models` to list the models your key can use.
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback. Used ONLY when Gemini returns a rate-limit (429) or 5xx / network error.
# Both must be set for the fallback to run. Key: https://console.groq.com/keys
GROQ_API_KEY=
# A Groq production chat model, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b

# Required. Comma-separated browser origins allowed to call /api/chat (exact match, no trailing slash).
# Add "null" locally only if you open test/chat.html straight from disk (file://).
ALLOWED_ORIGINS=https://your-portfolio.vercel.app,http://localhost:1313

# Your portfolio URL. The assistant mentions it when relevant.
PORTFOLIO_URL=https://your-portfolio.vercel.app

# Recommended: MongoDB Atlas for shared rate limiting (10/min, 60/day per IP), question logs and feedback.
# Without MONGODB_URI, logging/feedback are skipped and an in-memory, per-instance rate limiter is used.
# Use a database user with readWrite on MONGODB_DB only. See README → "MongoDB Atlas setup".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio_chat

# Local dev only (ignored on Vercel): DNS servers for the mongodb+srv:// lookup, for machines whose
# resolver refuses SRV queries (error "querySrv ECONNREFUSED").
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Required with MONGODB_URI: secret salt for hashing IPs in rate-limit keys (raw IPs are never stored).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
